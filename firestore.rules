rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read the board; each phone can only write its own row.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.nick is string
        && request.resource.data.nick.size() <= 24
        && request.resource.data.total is number;
    }

    // Shared by the week features: a week key like 2026-w4, the display fields every doc carries, and the
    // server time. `at` must be the request time (the app writes serverTimestamp()), so it cannot be forged:
    // the app drops votes stamped after that week's kickoff and picks stamped after that game's kickoff.
    function weekOk(week) {
      return week.matches('^[0-9]{4}-w[1-9][0-9]?$');
    }
    function whoOk(d) {
      return d.nick is string && d.nick.size() <= 24
        && (!('me' in d) || d.me == null || (d.me is string && d.me.size() <= 24))
        && d.at == request.time;
    }

    // Matchup of the Week votes: one per phone per week (motw/2026-w4/votes/{uid}). Lock times are enforced
    // by the app (a friends' league); the rules enforce ownership and shape.
    match /motw/{week}/votes/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && weekOk(week)
        && request.resource.data.keys().hasOnly(['pick', 'me', 'nick', 'at'])
        && request.resource.data.pick is string && request.resource.data.pick.size() <= 40
        && whoOk(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // NFL pick'em: one doc per phone per real NFL game (nflpicks/2026-w4/picks/{uid}__{espnGameId}), stamped
    // when it is made (`at`) and with the kickoff it was made for (`kick`). The kickoff lock is enforced here: no
    // new pick at or after its `kick`, and no change or delete of a doc once its own `kick` has passed, so a pick
    // can't be erased after its game. The app drops docs whose `kick` is later than ESPN's kickoff (so a forged
    // future `kick` never counts) and docs whose `at` is at or after that game's kickoff.
    // A phone that has locked in the week (its doc in locks, below) can't create, change or delete a pick of that
    // week. The app also drops picks a locked-in manager makes after the lock from any other phone, and refuses
    // changes from a phone whose picks carry that manager (the rules check only the phone that locked).
    function pickOk(pickId, d) {
      return pickId == request.auth.uid + '__' + d.game
        && d.keys().hasOnly(['uid', 'game', 'team', 'me', 'nick', 'at', 'kick'])
        && d.uid == request.auth.uid
        && d.game is string && d.game.matches('^[0-9]{1,12}$')
        && d.team is string && d.team.size() <= 4
        && d.kick is timestamp && request.time < d.kick
        && whoOk(d);
    }
    match /nflpicks/{week}/picks/{pickId} {
      allow read: if true;
      allow create: if request.auth != null && weekOk(week) && pickOk(pickId, request.resource.data)
        && !exists(/databases/$(database)/documents/nflpicks/$(week)/locks/$(request.auth.uid));
      allow update: if request.auth != null && weekOk(week) && request.time < resource.data.kick
        && pickOk(pickId, request.resource.data)
        && !exists(/databases/$(database)/documents/nflpicks/$(week)/locks/$(request.auth.uid));
      allow delete: if request.auth != null && pickId.matches('^' + request.auth.uid + '__[0-9]{1,12}$')
        && request.time < resource.data.kick
        && !exists(/databases/$(database)/documents/nflpicks/$(week)/locks/$(request.auth.uid));
    }
    // Locking in: one doc per phone per week (nflpicks/2026-w4/locks/{uid}) = {uid, me, nick, at, n (how many picks
    // it locked)}, never changed. It can be taken back only within 2 minutes of `at` (the app's Undo); after that
    // the week's picks from this phone are final. Anyone can read who has locked in (never anyone's picks).
    match /nflpicks/{week}/locks/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && weekOk(week)
        && request.resource.data.keys().hasOnly(['uid', 'me', 'nick', 'at', 'n'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 32
        && whoOk(request.resource.data);
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid
        && request.time < resource.data.at + duration.value(2, 'm');
    }

    // Press Room: the Matchup of the Week loser's postgame press conference, one per week (pressers/2026-w4).
    // The video lives on YouTube (unlisted); the doc holds its 11-character id. A friends' league: any phone may
    // post, replace or remove a week's presser; the rules enforce the shape.
    match /pressers/{week} {
      allow read: if true;
      allow create, update: if request.auth != null && weekOk(week)
        && request.resource.data.keys().hasOnly(['vid', 'who', 'title', 'tall', 'me', 'nick', 'at'])
        && request.resource.data.vid is string && request.resource.data.vid.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.who is string && request.resource.data.who.size() > 0 && request.resource.data.who.size() <= 24
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 80))
        && (!('tall' in request.resource.data) || request.resource.data.tall is bool)
        && whoOk(request.resource.data);
      allow delete: if request.auth != null && weekOk(week);
    }
  }
}
